#!/usr/bin/env php
<?php

declare(strict_types=1);

use FullSystem\Install\Application;

$autoloaders = [
    __DIR__.'/../vendor/autoload.php',   // cloned or installed by cpx
    __DIR__.'/../../../autoload.php',    // required as a dependency of a project
];

foreach ($autoloaders as $autoloader) {
    if (file_exists($autoloader)) {
        require $autoloader;

        break;
    }
}

if (! class_exists(Application::class)) {
    fwrite(STDERR, "Unable to locate the Composer autoloader. Run `composer install` first.\n");

    exit(1);
}

exit((new Application)->run());
